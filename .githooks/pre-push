#!/bin/sh
# 阻止直接推送到 main —— 所有改动必须走 PR。
#
# 安装（每个 clone 都要做一次，因为 git 不自动启用仓库里的 hooks）：
#     git config core.hooksPath .githooks
#
# 为什么用 .githooks 而不是 .git/hooks：
#     .git/ 不进版本库，队友 clone 下来不会有这个钩子；
#     放仓库里 + core.hooksPath 才能全员共享同一份规则。
#
# 逃生舱：ALLOW_MAIN_PUSH=1 git push origin main
#     只给两种情况用：① 仓库刚建、还没有 PR 流程；② GitHub 服务挂了要应急。
#     用完记得在群里说一声推了什么，别悄悄用。
#
# 注意：这个钩子只防"手滑"和"图省事"，防不住 `--no-verify`。
# 真正的强制力来自 GitHub 的分支保护（见 docs/12 第 6 节），
# 那一层是服务端的，本地绕不过去。

remote="$1"

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # 删除远程分支（local_sha 全 0）不算推送，放行
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac

    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            if [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
                blocked=1
            fi
            ;;
    esac
done

if [ "$blocked" = "1" ]; then
    echo "" >&2
    echo "  ✗ 拒绝直接推送到 main。" >&2
    echo "" >&2
    echo "    main 是随时可演示的分支，直推会让队友的工作区突然变样、也没人审过。" >&2
    echo "    正确做法：" >&2
    echo "      git switch -c feat/你的功能" >&2
    echo "      git push -u origin HEAD" >&2
    echo "      # 然后在 GitHub 上开 PR，等审核通过再合并" >&2
    echo "" >&2
    echo "    应急放行（仅管理员，用完在群里说一声）：" >&2
    echo "      ALLOW_MAIN_PUSH=1 git push origin main" >&2
    echo "" >&2
    exit 1
fi

exit 0
