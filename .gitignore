# 运行时生成，不进仓库
# 注意这里是 /data/（只锚定仓库根目录）。写成 data/ 会把 mock_business/data/
# 里的沙箱数据一起忽略掉——那是要进仓库的测试数据，不是运行产物。
/data/
*.db
*.db-journal
mock_business/data/tickets.json

# 交付包产物（评审用的 zip 由 scripts/export_submission.py 生成，不入库）
/dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 密钥与本地配置（绝对不能提交）
.env
.env.*
config.local.json
config/secrets.json
*.key

# 音频与模型（大文件，别进 git）
*.wav
*.mp3
*.webm
*.onnx
*.pt
*.bin

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 上架前留的线上原件（本机回滚用，不进仓库）
*.bak_*

# 评测每日归档（本地运行产物；趋势数据不进仓库，报告另存 eval/reports/）
/eval/runs/

# 评测报告是生成物（本地另存或走 CI 产物），不进仓库
/eval/reports/

# 版本快照是回滚点（本地留存），不进仓库
/eval/history/

# Q4：画像工厂是确定性生成物（scripts/gen_adversarial.py 可复算），不进仓库
/eval/personas_generated.json
